---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Callout from '../../../components/Callout.astro';
import Flow from '../../../components/diagrams/Flow.astro';
import Stack from '../../../components/diagrams/Stack.astro';
import Trace from '../../../components/diagrams/Trace.astro';
import Compare from '../../../components/diagrams/Compare.astro';
import Bars from '../../../components/diagrams/Bars.astro';
import Lanes from '../../../components/diagrams/Lanes.astro';
import Fan from '../../../components/diagrams/Fan.astro';
import States from '../../../components/diagrams/States.astro';
import Stage from '../../../components/Stage.astro';
import Progress from '../../../components/Progress.astro';
import { PROJECTS, href, SITE } from '../../../lib/site';
import { projectPages } from '../../../lib/projects';

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const pages = await projectPages(project.slug);
const overview = pages.find((p) => p.data.part === 0);
const parts = pages.filter((p) => p.data.part > 0);
const Content = overview ? (await render(overview)).Content : null;
---
<Base lesson title={project.title} description={project.blurb}>
  <nav class="lesson-nav"><a class="all" href={href('/p/')}>All projects</a></nav>
  <article class="lesson">
  <header class="lesson-head">
    <div class="kicker">{project.kicker}</div>
    <h1>{project.title}</h1>
    <p class="tagline">{overview?.data.tagline ?? project.blurb}</p>
    <div class="byline"><span>{parts.length} parts</span><span>·</span><a href={`${SITE.repo}/tree/main/projects/${project.slug}`}>Code on GitHub</a></div>
  </header>
  <div class="prose" data-pagefind-body>
    {Content && <Content components={{ Callout, Flow, Stack, Trace, Compare, Bars, Lanes, Fan, States }} />}
  </div>
  </article>
  <section class="section-block">
    <h2>Parts</h2>
    <ol class="lesson-list">
      {parts.map((p) => (
        <li><a href={href(`/p/${project.slug}/${p.data.part}/`)}><span class="n">{p.data.part}</span><span class="t">{p.data.title}<small>{p.data.tagline}</small></span><span class="tick" data-tick={`p:${project.slug}/${p.data.part}`}></span></a></li>
      ))}
    </ol>
  </section>
  <Stage />
  <Progress />
</Base>
