---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LessonNav from '../../../components/LessonNav.astro';
import QuickCheck from '../../../components/QuickCheck.astro';
import Progress from '../../../components/Progress.astro';
import Stage from '../../../components/Stage.astro';
import Callout from '../../../components/Callout.astro';
import Flow from '../../../components/diagrams/Flow.astro';
import Stack from '../../../components/diagrams/Stack.astro';
import Trace from '../../../components/diagrams/Trace.astro';
import Compare from '../../../components/diagrams/Compare.astro';
import Bars from '../../../components/diagrams/Bars.astro';
import Lanes from '../../../components/diagrams/Lanes.astro';
import Fan from '../../../components/diagrams/Fan.astro';
import States from '../../../components/diagrams/States.astro';
import { lessons, sections, href, usedInLink, SITE, type Lesson } from '../../../lib/site';

export async function getStaticPaths() {
  const all = await lessons();
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: all[i - 1], next: all[i + 1] } }));
}
interface Props { entry: Lesson; prev?: Lesson; next?: Lesson }
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const section = sections.find((s) => s.id === d.section)!;
const sectionNum = sections.indexOf(section) + 1;
---
<Base lesson title={d.title} description={`${d.tagline} Lesson ${d.order} of the free AI agents course.`}>
  <LessonNav prev={prev} next={next} />
  <article class="lesson" data-pagefind-body>
    <header class="lesson-head">
      <div class="kicker">Section {sectionNum} · {section.title} · Lesson {d.order}</div>
      <h1>{d.title}</h1>
      <p class="tagline">{d.tagline}</p>
      <div class="byline">
        <span>by <a href={href('/about/')}>{SITE.author}</a></span>
        <span>·</span><span>{d.readingMinutes} min read</span>
        <span>·</span><span>Real world: {d.realWorld}</span>
      </div>
    </header>
    <div class="prose">
      <Content components={{ Callout, Flow, Stack, Trace, Compare, Bars, Lanes, Fan, States }} />
    </div>
  </article>

  <div class="lesson-after">
    {d.build.type !== 'none' && (
      <aside class="after-side">
        <div class="build-cta">
          <div class="build-art" aria-hidden="true">
            <span class="ba-node">{d.build.type === 'code' ? 'agent.py' : 'Model'}</span>
            <span class="ba-wire"><i></i></span>
            <span class="ba-node">{d.build.type === 'code' ? 'Check ✓' : 'Tools'}</span>
          </div>
          <div><strong>Now build it yourself</strong><p>{d.build.type === 'code' ? 'Write and run real Python in your browser. No install.' : 'Wire the parts on a canvas, run the scenario, and watch where it breaks.'}</p></div>
          <a class="btn" href={href(`/c/${entry.id}/build/`)}>Build it →</a>
        </div>
      </aside>
    )}
    <div class="after-main">
      {d.usedIn.length > 0 && (
        <div class="chips">Used in:{d.usedIn.map((u) => { const l = usedInLink(u); return <a class="chip" href={l.url} title={l.title}>{l.label}</a>; })}</div>
      )}

      <QuickCheck quiz={d.quiz} />

      {d.reading.length > 0 && (
        <section class="reading prose">
          <h2>Further reading</h2>
          <ul>{d.reading.map((r) => <li><a href={r.url} rel="noopener">{r.title}</a></li>)}</ul>
        </section>
      )}

      <div class="complete-row">
        <button type="button" class="btn ghost" data-complete-toggle={entry.id} aria-pressed="false">Mark complete</button>
      </div>
    </div>
  </div>
  <LessonNav prev={prev} next={next} />
  <Stage />
  <Progress />
</Base>
