      "retrieve_tiny": 0,
      "retrieve_tiny_overlap": 0,
      "retrieve_mid": 0,
      "retrieve_mid_no_overlap": 0,
      "retrieve_big": 0,
      "rule_only": 0,
      "exception": 0,
      "diluted": 0,
      "plain_right": 0
    },
    "modifiers": [
