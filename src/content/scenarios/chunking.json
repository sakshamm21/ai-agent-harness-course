  "goals": [
    {
      "id": "accuracy",
      "label": "At least 85% of answers right",
      "metric": "success_rate",
      "op": ">=",
      "value": 0.85
    },
    {
      "id": "cost",
      "label": "Under $0.025 per question",
      "metric": "avg_cost",
      "op": "<=",
      "value": 0.025
    }
  ],
  "hints": [
    "Open a wrong answer in the transcript and read the retrieved chunks. Where did the exception go?",
    "A 100-token chunk holds about 3 sentences. Most handbook sections are 250 to 400 tokens. Huge chunks are not the answer either: they cost more and their vectors blur.",
    "Set Chunk size to about 400 tokens and Overlap to about 60 (roughly 15%), keeping Top k at 3."
  ],
  "explain": "Chunk size decides what can be found together. Chunks the size of one section keep a rule next to its exception, a little overlap rescues sentences that straddle a boundary, and chunks far larger than the question blur the embedding and inflate the prompt."
}
