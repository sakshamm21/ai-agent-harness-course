  "tasks": [
    {
      "id": "q1",
      "label": "Annual plan refund",
      "prompt": "I paid for the annual plan 10 days ago. Can I get a full refund?",
      "tags": [
        "exception"
      ]
    },
    {
      "id": "q2",
      "label": "Late return",
      "prompt": "My order arrived 40 days ago but it was a holiday gift. Can I still return it?",
      "tags": [
        "exception"
      ]
    },
    {
      "id": "q3",
      "label": "Seat removal",
      "prompt": "If I remove 3 seats mid-month, when does my bill go down?",
      "tags": [
        "exception"
      ]
    },
    {
      "id": "q4",
      "label": "Data export",
      "prompt": "How do I export all my data before closing the account?",
      "tags": [
        "plain"
      ]
    }
  ],
  "actions": {
    "retrieve_tiny": {
      "kind": "think",
      "text": "Retriever: top 3 of 4,180 chunks (100 tokens each): \"Refunds are available within 14 days of purchase.\" | \"...of purchase. Refunds go back to the original\" | \"Returns must start within 30 days of delivery.\" The next sentence of each was cut off.",
      "tokens": 300
    },
    "retrieve_tiny_overlap": {
      "kind": "think",
      "text": "Retriever: top 3 of 6,000+ chunks (100 tokens, overlapping): \"...within 14 days of purchase. Annual plans are an exception: they are\" (cut) | ...",
      "tokens": 300
    },
    "retrieve_mid": {
      "kind": "think",
      "text": "Retriever: top 3 of about 1,240 chunks (~400 tokens each, overlapping): \"Refunds are available within 14 days of purchase. Annual plans are an exception: they are refunded pro rata for unused months...\" (full section).",
      "tokens": 1200
    },
    "retrieve_mid_no_overlap": {
      "kind": "think",
      "text": "Retriever: top 3 of 1,050 chunks (~400 tokens each, no overlap). Most sections fit, but the holiday-gift exception starts right at a chunk boundary.",
      "tokens": 1200
    },
    "retrieve_big": {
      "kind": "think",
      "text": "Retriever: top 3 of 210 chunks (2,000 tokens each, whole chapters). The refund chapter ranks 2nd: its vector is an average of 40 different rules.",
      "tokens": 6000
    },
    "rule_only": {
      "kind": "answer",
      "correct": false,
      "text": "Yes. Refunds are available within 14 days of purchase, so you'll get the full amount [handbook §4.1]. (Wrong: the annual-plan exception was in the next chunk.)"
    },
    "exception": {
      "kind": "answer",
      "correct": true,
      "text": "Annual plans are the exception to the 14-day rule: you get a pro-rata refund for the unused months, not the full amount [handbook §4.1, §4.2]."
    },
    "diluted": {
      "kind": "answer",
      "correct": false,
      "text": "Based on the billing chapter, seat changes take effect immediately [handbook §6]. (Wrong section: the right rule was inside a 2,000-token chunk that ranked lower.)"
    },
    "plain_right": {
      "kind": "answer",
      "correct": true,
      "text": "Go to Settings → Data → Export. You get a ZIP of all records by email within an hour [handbook §9.3]."
    }
  },
  "policy": {
