  "tasks": [
    {
      "id": "t1",
      "label": "Export to CSV",
      "prompt": "How do I export a report to CSV?",
      "needs": [
        "search_docs"
      ],
      "tags": [
        "docs"
      ]
    },
    {
      "id": "t2",
      "label": "Known login bug",
      "prompt": "Has customer #4411 already reported the login loop bug?",
      "needs": [
        "search_tickets"
      ],
      "tags": [
        "tickets"
      ]
    },
    {
      "id": "t3",
      "label": "SSO setup",
      "prompt": "Where do I turn on single sign-on for my workspace?",
      "needs": [
        "search_docs"
      ],
      "tags": [
        "docs"
      ]
    },
    {
      "id": "t4",
      "label": "Refund history",
      "prompt": "Did we already refund jane@example.com for the March outage?",
      "needs": [
        "search_tickets"
      ],
      "tags": [
        "tickets"
      ]
    }
  ],
  "actions": {
    "t1_right": {
      "kind": "tool",
      "tool": "search_docs",
      "text": "search_docs(\"export report csv\")",
      "tokens": 700
    },
    "t1_mixup": {
      "kind": "tool",
      "tool": "search_tickets",
      "text": "search_tickets(\"export report csv\")  -> 0 cases. Wrong tool: this is a how-to question.",
      "tokens": 250
    },
    "t1_web": {
      "kind": "tool",
      "tool": "search",
      "text": "search(\"export report csv\")  -> 10 public web results. Wrong tool: none of them are about our product or customers.",
      "tokens": 1100
    },
    "t1_bad": {
      "kind": "answer",
      "correct": false,
      "text": "I couldn't find export steps. Maybe try right-clicking the report? (Answered from the wrong tool's results.)"
    },
    "t1_done": {
      "kind": "answer",
      "correct": true,
      "text": "Go to Reports, open the report, then Export > CSV. Scheduled exports are under the same menu (help article: \"Exporting reports\")."
    },
    "t2_right": {
      "kind": "tool",
      "tool": "search_tickets",
      "text": "search_tickets(\"customer 4411 login loop\")",
      "tokens": 600
    },
    "t2_mixup": {
      "kind": "tool",
      "tool": "search_docs",
      "text": "search_docs(\"customer 4411 login loop\")  -> 0 articles. Wrong tool: the help center has no customer cases.",
      "tokens": 250
    },
    "t2_web": {
      "kind": "tool",
      "tool": "search",
      "text": "search(\"customer 4411 login loop\")  -> 10 public web results. Wrong tool: none of them are about our product or customers.",
      "tokens": 1100
    },
    "t2_bad": {
      "kind": "answer",
      "correct": false,
      "text": "I don't see any record of that. It looks like a new report. (Answered from the wrong tool's results.)"
    },
    "t2_done": {
      "kind": "answer",
      "correct": true,
      "text": "Yes. Customer #4411 opened case #8812 on May 3 about the login loop; engineering linked it to the SSO redirect bug."
    },
    "t3_right": {
      "kind": "tool",
      "tool": "search_docs",
      "text": "search_docs(\"enable single sign-on workspace\")",
      "tokens": 700
    },
    "t3_mixup": {
      "kind": "tool",
      "tool": "search_tickets",
      "text": "search_tickets(\"enable single sign-on workspace\")  -> 0 cases. Wrong tool: this is a how-to question.",
      "tokens": 250
    },
    "t3_web": {
      "kind": "tool",
      "tool": "search",
      "text": "search(\"enable single sign-on workspace\")  -> 10 public web results. Wrong tool: none of them are about our product or customers.",
      "tokens": 1100
    },
    "t3_bad": {
      "kind": "answer",
      "correct": false,
      "text": "SSO is usually under your identity provider's settings. Check with your IT team. (Answered from the wrong tool's results.)"
    },
    "t3_done": {
      "kind": "answer",
      "correct": true,
      "text": "Admins turn on SSO under Settings > Security > Single sign-on. You need the Business plan (help article: \"Set up SAML SSO\")."
    },
    "t4_right": {
      "kind": "tool",
      "tool": "search_tickets",
      "text": "search_tickets(\"jane@example.com refund March outage\")",
      "tokens": 600
    },
    "t4_mixup": {
      "kind": "tool",
      "tool": "search_docs",
      "text": "search_docs(\"jane@example.com refund March outage\")  -> 0 articles. Wrong tool: the help center has no customer cases.",
      "tokens": 250
    },
    "t4_web": {
      "kind": "tool",
      "tool": "search",
      "text": "search(\"jane@example.com refund March outage\")  -> 10 public web results. Wrong tool: none of them are about our product or customers.",
      "tokens": 1100
    },
    "t4_bad": {
      "kind": "answer",
      "correct": false,
      "text": "I found nothing about a refund, so probably not. You could issue one now. (Answered from the wrong tool's results.)"
    },
    "t4_done": {
      "kind": "answer",
      "correct": true,
      "text": "Yes. Case #9020 shows a $120 credit issued to jane@example.com on March 14 for the outage."
    }
