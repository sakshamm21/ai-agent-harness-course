---
// Progress lives in localStorage only. Every read and write is wrapped so private windows still work.
---
<script is:inline>
  (function () {
    var KEY = 'fah-progress';
    function load() { try { return JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { return {}; } }
    function save(p) { try { localStorage.setItem(KEY, JSON.stringify(p)); } catch (e) {} }
    window.fahProgress = { load: load, save: save, mark: function (slug, v) { var p = load(); if (v) p[slug] = 1; else delete p[slug]; save(p); paint(); } };
    function paint() {
      var p = load();
      document.querySelectorAll('[data-tick]').forEach(function (el) {
        var on = !!p[el.getAttribute('data-tick')];
        el.classList.toggle('done', on);
        el.textContent = on ? '✓' : '';
        el.setAttribute('aria-label', on ? 'Completed' : 'Not completed');
      });
      document.querySelectorAll('[data-complete-toggle]').forEach(function (b) {
        var on = !!p[b.getAttribute('data-complete-toggle')];
        b.textContent = on ? '✓ Completed' : 'Mark complete';
        b.classList.toggle('ghost', !on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      document.querySelectorAll('[data-progress-count]').forEach(function (el) {
        var total = +el.getAttribute('data-progress-count');
        var n = Object.keys(p).filter(function (k) { return !k.startsWith('p:'); }).length;
        el.textContent = n ? n + ' of ' + total + ' done' : '';
      });
    }
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-complete-toggle]');
      if (!b) return;
      var s = b.getAttribute('data-complete-toggle');
      window.fahProgress.mark(s, !load()[s]);
    });
    window.addEventListener('fah-progress', paint);
    paint();
  })();
</script>
