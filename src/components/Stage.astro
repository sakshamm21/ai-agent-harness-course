---
/**
 * Drives the two-pane lesson layout built by src/lib/rehype-scrolly.mjs.
 * Wide screens: the frame whose marker the reader has scrolled past shows in the sticky stage.
 * Narrow screens: the stage is hidden and each inline figure plays as it scrolls into view.
 */
---
<div class="read-progress" aria-hidden="true"><i></i></div>
<script>
  const stage = document.querySelector<HTMLElement>('.stage');
  const markers = [...document.querySelectorAll<HTMLElement>('.scrolly-text .vis')];
  const frames = [...document.querySelectorAll<HTMLElement>('.stage .frame')];
  const pips = [...document.querySelectorAll<HTMLElement>('.stage [data-pip]')];
  const count = document.querySelector<HTMLElement>('.stage-count');
  const wide = window.matchMedia('(min-width: 1100px)');
  let active = -1;
  const bar = document.querySelector<HTMLElement>('.read-progress');
  const article = document.querySelector<HTMLElement>('article.lesson');
  function progress() {
    if (!bar || !article) return;
    const r = article.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - window.innerHeight * 0.6)));
    bar.style.setProperty('--p', p.toFixed(4));
  }
  window.addEventListener('scroll', () => requestAnimationFrame(progress), { passive: true });
  progress();

  // Number each code line so lines can cascade in when a frame plays.
  document.querySelectorAll<HTMLElement>('.frame-code pre, .vis-inline pre').forEach((pre) => {
    pre.querySelectorAll<HTMLElement>('.line').forEach((l, i) => l.style.setProperty('--i', String(Math.min(i, 40))));
  });

  const play = (el: Element) => {
    el.classList.remove('play');
    void (el as HTMLElement).offsetWidth; // restart CSS animations
    el.classList.add('play');
  };

  function setActive(i: number) {
    if (!frames.length || i === active) return;
    active = Math.max(0, Math.min(frames.length - 1, i));
    frames.forEach((f, k) => {
      if (k === active) { f.setAttribute('data-active', ''); f.removeAttribute('aria-hidden'); play(f); }
      else { f.removeAttribute('data-active'); f.setAttribute('aria-hidden', 'true'); }
    });
    pips.forEach((p, k) => p.toggleAttribute('data-on', k === active));
    markers.forEach((m, k) => m.toggleAttribute('data-current', k === active));
    if (count) count.textContent = `${active + 1} / ${frames.length}`;
  }

  let lockUntil = 0; // after a click, let the smooth scroll finish before scroll position decides again
  function pick() {
    if (!wide.matches || performance.now() < lockUntil) return;
    const line = window.innerHeight * 0.55;
    let i = 0;
    markers.forEach((m, k) => { if (m.getBoundingClientRect().top < line) i = k; });
    setActive(i);
  }

  function goTo(i: number) {
    const m = markers[Math.max(0, Math.min(markers.length - 1, i))];
    if (!m) return;
    const y = m.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.4;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    lockUntil = performance.now() + (reduce ? 50 : 900);
    window.scrollTo({ top: y, behavior: reduce ? 'auto' : 'smooth' });
    setActive(i);
  }

  if (stage && frames.length) {
    let queued = false;
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; pick(); });
    }, { passive: true });
    wide.addEventListener('change', pick);
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const marker = t.closest<HTMLElement>('[data-goto]');
      if (marker) { lockUntil = performance.now() + 600; setActive(Number(marker.dataset.goto)); return; }
      if (t.closest('[data-stage-prev]')) goTo(active - 1);
      if (t.closest('[data-stage-next]')) goTo(active + 1);
      const pip = t.closest<HTMLElement>('[data-pip]');
      if (pip) goTo(Number(pip.dataset.pip));
    });
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); goTo(active + 1); }
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); goTo(active - 1); }
    });
    active = -1;
    setActive(0);
    pick();
  }

  // Narrow screens (and any inline figure): play once when it scrolls into view.
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { play(e.target); io.unobserve(e.target); }
    }, { threshold: 0.35 });
    document.querySelectorAll('.vis-inline, .prose > figure.diagram').forEach((el) => io.observe(el));
  }
</script>
